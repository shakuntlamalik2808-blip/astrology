rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated Firebase user is an admin.
    // Add / remove users in Firebase Console → Authentication → Users.
    function isAdmin() {
      return request.auth != null;
    }

    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function slotId(v) { return v.preferredDate + '_' + v.preferredTime; }

    // ── Consultations ────────────────────────────────────────────────────────
    match /consultations/{id} {

      // Authenticated admins can do everything.
      allow read, update, delete: if isAdmin();

      // Admins can create any well-formed consultation (no field restrictions).
      allow create: if isAdmin();

      // Unauthenticated visitors can only create a strictly validated request.
      allow create: if !isAdmin()
        && id == request.resource.data.consultationId
        && request.resource.data.keys().hasOnly([
             'consultationId','fullName','whatsappNumber','email',
             'dateOfBirth','timeOfBirth','placeOfBirth','currentCity',
             'consultationType','preferredDate','preferredTime',
             'additionalMessage','source','status','createdAt','updatedAt'
           ])
        && str(request.resource.data.fullName, 2, 100)
        && request.resource.data.whatsappNumber.matches('^\\+[0-9]{7,18}$')
        && request.resource.data.email is string
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && str(request.resource.data.placeOfBirth, 2, 120)
        && str(request.resource.data.currentCity, 2, 120)
        && str(request.resource.data.consultationType, 2, 100)
        && str(request.resource.data.preferredDate, 10, 10)
        && str(request.resource.data.preferredTime, 4, 8)
        && str(request.resource.data.additionalMessage, 0, 1500)
        && request.resource.data.source == 'website'
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/availableSlots/$(slotId(request.resource.data))).data.enabled == true
        && getAfter(/databases/$(database)/documents/bookedSlots/$(slotId(request.resource.data))).data.consultationId == id;
    }

    // ── Other admin-only collections ─────────────────────────────────────────
    match /customers/{id}     { allow read, write: if isAdmin(); }
    match /notifications/{id} { allow read: if isAdmin(); allow write: if false; }

    // Public visitors can view open times and minimal date/time reservations.
    // Only admins can manage availability; a public reservation must be written
    // in the same transaction as its consultation and reference an enabled slot.
    match /availableSlots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bookedSlots/{id} {
      allow read: if true;
      allow create: if isAdmin() || (!isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'time', 'consultationId'])
        && id == request.resource.data.date + '_' + request.resource.data.time
        && get(/databases/$(database)/documents/availableSlots/$(id)).data.enabled == true
        && getAfter(/databases/$(database)/documents/consultations/$(request.resource.data.consultationId)).data.preferredDate == request.resource.data.date
        && getAfter(/databases/$(database)/documents/consultations/$(request.resource.data.consultationId)).data.preferredTime == request.resource.data.time);
      allow update, delete: if isAdmin();
    }

    // settings/* is seeded automatically on first login — admins need write
    // access so the client can create the document if it doesn't exist yet.
    match /settings/{id}      { allow read: if isAdmin() || id == 'website'; allow write: if isAdmin(); }
  }
}
